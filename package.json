{
  "name": "apple-music",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player"
        ]
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    },
    "install": {
      "exclude": [
        "typescript"
      ]
    }
